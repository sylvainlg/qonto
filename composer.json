{
  "name": "sylvainlg/php-qonto",
  "description": "Qonto API client for PHP",
  "keywords": [
    "qonto"
  ],
  "homepage": "https://github.com/sylvainlg/php-qonto",
  "type": "library",
  "require": {
    "php": ">=8.0",
    "symfony/http-client": "^6.0|^7.0",
    "symfony/serializer": "^6.0|^7.0",
    "symfony/property-access": "^6.0|^7.0",
    "phpdocumentor/reflection-docblock": "^5.0",
    "symfony/property-info": "^6.0|^7.0",
    "symfony/uid": "^6.0|^7.0"
  },
  "autoload": {
    "psr-4": {
      "neyric\\Qonto\\": "Qonto/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "neyric\\Qonto\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0|^12.0",
    "phpstan/phpstan": "^1.0|^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse Qonto tests --level 7"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Eric Abouaf",
      "email": "eric.abouaf@gmail.com"
    },
    {
      "name": "Sylvain Le Gléau",
      "email": "sylvain@legleau.com"
    }
  ],
  "minimum-stability": "stable"
}
